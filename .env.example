# Server
PORT=3402
NODE_ENV=development

# x402 Payment Protocol
X402_NETWORK=eip155:84532
X402_PAY_TO=0xYOUR_WALLET_ADDRESS
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_SCHEME=exact
X402_SYNC_ON_START=false

# Pricing (USD)
PRICE_REPUTATION_QUERY=0.001
PRICE_REPUTATION_SUMMARY=0.0005
PRICE_ATTESTATION_QUERY=0.001
PRICE_EVENT_SUBMIT=0.01

# Database
DB_PATH=./data/reputation.db

# Server Identity (EVM private key for signing receipts/attestations)
SERVER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Security
MAX_EVENTS_PER_AGENT_PER_HOUR=100
