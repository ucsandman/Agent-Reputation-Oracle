# Server
PORT=3402
NODE_ENV=development   # defaults to production (x402 enforced) when unset

# x402 Payment Protocol
X402_NETWORK=eip155:84532
X402_PAY_TO=0xYOUR_WALLET_ADDRESS
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_SCHEME=exact
X402_SYNC_ON_START=false   # set true in production: fetches the facilitator's supported networks at boot, paid routes 503 without it

# Pricing (USD)
PRICE_REPUTATION_QUERY=0.001
PRICE_REPUTATION_SUMMARY=0.0005
PRICE_ATTESTATION_QUERY=0.001
PRICE_EVENT_SUBMIT=0   # 0 = free writes (x402 not required to submit events)

# Database
DB_PATH=./data/reputation.db

# Server Identity (EVM private key for signing receipts/attestations)
SERVER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Security
MAX_EVENTS_PER_AGENT_PER_HOUR=100

# ERC-8004 importer (npm run index:erc8004) — see docs/erc8004.md for per-chain registry addresses
ERC8004_RPC_URL=https://mainnet.base.org
ERC8004_CHAIN_ID=8453
ERC8004_REPUTATION_REGISTRY=
ERC8004_IDENTITY_REGISTRY=
ERC8004_FROM_BLOCK=
ERC8004_TO_BLOCK=
ERC8004_SYNC_INTERVAL_SECONDS=300   # server-side poll; the server backfills on boot when ERC8004_* are set
