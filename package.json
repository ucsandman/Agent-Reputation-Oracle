{
  "name": "agent-reputation-oracle",
  "version": "1.0.0",
  "type": "module",
  "description": "Protocol-native Agent Reputation Oracle for x402 payment protocol",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "seed": "tsx scripts/seed.ts",
    "replay": "tsx scripts/replay.ts",
    "index:erc8004": "tsx --env-file=.env scripts/index-erc8004.ts"
  },
  "keywords": [
    "x402",
    "reputation",
    "oracle",
    "agent",
    "evm"
  ],
  "author": "ucsandman",
  "license": "MIT",
  "overrides": {
    "ws": "^8.20.1",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "@x402/express": "^2.3.0",
    "better-sqlite3": "^12.10.0",
    "express": "^4.21.0",
    "uuid": "^11.0.0",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
